@media (prefers-color-scheme: dark) {
    page {
        background: rgb(21, 23, 26);
        color: rgb(199, 212, 248);
    }

    .card {
        background: rgb(17, 17, 17);
    }

    .section-title {
        color: rgb(210, 220, 255);
    }

    .section-subtitle {
        color: rgb(89, 102, 127);
    }

    .muted {
        color: rgb(89, 102, 127);
    }

    .primary-btn {
        background: rgb(0, 0, 0);
        color: rgb(17, 17, 17);
    }

    .secondary-btn {
        background: rgb(19, 25, 32);
        color: rgb(0, 119, 237);
    }

    .ghost-btn {
        background: rgb(17, 17, 17);
        color: rgb(125, 142, 172);
        border: rgb(0, 0, 0);
    }

    .tag-pending {
        background: rgb(19, 25, 32);
        color: rgb(0, 119, 237);
    }

    .tag-accepted {
        background: rgb(11, 26, 23);
        color: rgb(0, 124, 89);
    }

    .tag-completed {
        background: rgb(22, 26, 22);
        color: rgb(75, 137, 85);
    }

    .tag-cancelled {
        background: rgb(31, 23, 19);
        color: rgb(173, 55, 23);
    }

    .tag-takeout {
        background: rgb(27, 21, 10);
        color: rgb(157, 78, 0);
    }

    .tag-parcel {
        background: rgb(22, 27, 35);
        color: rgb(106, 134, 255);
    }

    .price-text {
        color: rgb(165, 44, 0);
    }

    .avatar-circle {
        color: rgb(17, 17, 17);
    }

    .theme-ocean {
        background: rgb(0, 0, 0);
    }

    .theme-mint {
        background: rgb(0, 0, 0);
    }

    .theme-sky {
        background: rgb(0, 0, 0);
    }

    .theme-sun {
        background: rgb(0, 0, 0);
    }

    .list-empty {
        color: rgb(88, 101, 126);
    }

    .list-empty-title {
        color: rgb(140, 157, 186);
    }

    .form-title {
        color: rgb(198, 210, 249);
    }

    .field-label {
        color: rgb(142, 160, 193);
    }

    .field-required {
        color: rgb(179, 39, 14);
    }

    .field-input, .field-textarea {
        background: rgb(19, 21, 25);
        border: rgb(0, 0, 0);
        color: rgb(198, 210, 249);
    }

    .field-tip {
        color: rgb(78, 91, 112);
    }

    .pill-item {
        border: rgb(0, 0, 0);
        background: rgb(17, 17, 17);
        color: rgb(140, 157, 186);
    }

    .pill-item.active {
        border-color: rgb(0, 119, 237);
        background: rgb(19, 25, 32);
        color: rgb(0, 119, 237);
    }

    .stat-label {
        color: rgb(89, 102, 127);
    }

    .stat-value {
        color: rgb(199, 215, 249);
    }

    .notice-box {
        background: rgb(18, 21, 24);
    }

    .notice-title {
        color: rgb(198, 210, 249);
    }

    .notice-desc {
        color: rgb(100, 113, 137);
    }

    .notice-time {
        color: rgb(73, 84, 104);
    }

    .link-text {
        color: rgb(0, 119, 237);
    }
}
