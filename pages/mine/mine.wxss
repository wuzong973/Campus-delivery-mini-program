.profile-card {
  padding: 28rpx;
  background: linear-gradient(160deg, #ffffff, #eef7ff);
}

.profile-main {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.profile-text {
  flex: 1;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #21314c;
}

.profile-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6e7f99;
}

.profile-badge {
  min-width: 136rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #eef6ff;
  text-align: center;
  color: #1e86ff;
  font-size: 24rpx;
  font-weight: 700;
}

.profile-extra {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 26rpx;
  color: #8593ad;
  font-size: 24rpx;
}

.action-panel {
  padding: 10rpx 24rpx;
}

.action-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.action-line:last-child {
  border-bottom: none;
}

.action-title {
  font-size: 28rpx;
  color: #23314d;
  font-weight: 600;
}

.action-value {
  font-size: 24rpx;
  color: #8a97b2;
}

.contact-line {
  align-items: center;
}

.contact-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  border: none;
  background: #eef6ff;
  color: #1e86ff;
  font-size: 24rpx;
}

.contact-btn::after {
  border: none;
}

.notice-list,
.preview-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.preview-card {
  padding: 22rpx;
}

.preview-title,
.preview-desc,
.preview-meta {
  display: block;
}

.preview-title {
  max-width: 450rpx;
  font-size: 28rpx;
  color: #243250;
  font-weight: 700;
}

.preview-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #71809b;
}

.preview-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #98a5bd;
}
