@media (prefers-color-scheme: dark) {
    .pay-chip.paid {
        background: rgb(11, 26, 23);
        color: rgb(0, 124, 89);
    }

    .pay-chip.unpaid {
        background: rgb(31, 23, 19);
        color: rgb(173, 55, 23);
    }

    .detail-title {
        color: rgb(198, 213, 248);
    }

    .detail-time {
        color: rgb(79, 95, 119);
    }

    .finance-item {
        background: rgb(18, 21, 24);
    }

    .finance-label {
        color: rgb(89, 102, 127);
    }

    .finance-value {
        color: rgb(198, 210, 249);
    }

    .timeline-panel {
        background: rgb(18, 21, 24);
    }

    .timeline-dot {
        background: rgb(38, 47, 57);
    }

    .timeline-item.done .timeline-dot {
        background: rgb(0, 119, 237);
    }

    .timeline-title {
        color: rgb(199, 213, 247);
    }

    .timeline-time {
        color: rgb(88, 101, 124);
    }

    .route-panel {
        background: rgb(18, 21, 24);
    }

    .route-sign {
        color: rgb(17, 17, 17);
    }

    .route-pick {
        background: rgb(0, 119, 237);
    }

    .route-send {
        background: rgb(0, 124, 89);
    }

    .route-name {
        color: rgb(102, 116, 143);
    }

    .route-value {
        color: rgb(182, 199, 232);
    }

    .route-sub {
        color: rgb(88, 101, 124);
    }

    .route-link {
        color: rgb(0, 119, 237);
    }

    .info-row {
        border-bottom: rgb(0, 0, 0);
    }

    .info-label {
        color: rgb(101, 115, 141);
    }

    .info-value {
        color: rgb(199, 213, 247);
    }

    .remark-box {
        background: rgb(25, 21, 15);
    }

    .remark-title {
        color: rgb(158, 79, 0);
    }

    .remark-text {
        color: rgb(196, 153, 112);
    }

    .taker-row {
        border-top: rgb(0, 0, 0);
    }

    .user-name {
        color: rgb(199, 213, 247);
    }

    .user-desc {
        color: rgb(100, 114, 140);
    }

    .user-meta {
        color: rgb(78, 91, 112);
    }

    .proof-title, .rate-title {
        color: rgb(199, 213, 247);
    }

    .proof-image {
        background: rgb(22, 26, 31);
    }

    .proof-desc {
        color: rgb(100, 114, 140);
    }

    .attachment-image {
        background: rgb(22, 26, 31);
    }

    .rate-chip {
        background: rgb(21, 23, 26);
        color: rgb(125, 142, 172);
    }

    .rate-chip.active {
        background: rgb(19, 25, 32);
        color: rgb(0, 119, 237);
    }
}
