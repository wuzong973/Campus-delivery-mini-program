.detail-card {
  padding: 28rpx 24rpx;
}

.task-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.pay-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.pay-chip.paid {
  background: #e9fbf7;
  color: #11a57f;
}

.pay-chip.unpaid {
  background: #fff2ed;
  color: #f2734c;
}

.detail-title {
  display: block;
  margin-top: 22rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #21314c;
}

.detail-time {
  display: block;
  margin-top: 12rpx;
  color: #90a0ba;
  font-size: 24rpx;
}

.finance-panel {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.finance-item {
  padding: 18rpx 14rpx;
  border-radius: 18rpx;
  background: #f8fbff;
  text-align: center;
}

.finance-label,
.finance-value {
  display: block;
}

.finance-label {
  font-size: 22rpx;
  color: #8a97b2;
}

.finance-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #243250;
  font-weight: 700;
}

.timeline-panel {
  margin-top: 26rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #f8fbff;
}

.timeline-item {
  display: flex;
  gap: 16rpx;
}

.timeline-item + .timeline-item {
  margin-top: 16rpx;
}

.timeline-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #cfd9e6;
  flex-shrink: 0;
}

.timeline-item.done .timeline-dot {
  background: #1e86ff;
}

.timeline-title,
.timeline-time {
  display: block;
}

.timeline-title {
  font-size: 26rpx;
  color: #22314b;
  font-weight: 600;
}

.timeline-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8c99b2;
}

.route-panel {
  margin-top: 28rpx;
  padding: 24rpx 22rpx;
  border-radius: 22rpx;
  background: #f8fbff;
}

.route-item {
  display: flex;
  gap: 16rpx;
}

.route-item + .route-item {
  margin-top: 20rpx;
}

.route-sign {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 50%;
  text-align: center;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.route-pick {
  background: #1e86ff;
}

.route-send {
  background: #11a57f;
}

.route-name,
.route-value,
.route-link {
  display: block;
}

.route-name {
  color: #7b89a5;
  font-size: 22rpx;
}

.route-value {
  margin-top: 8rpx;
  color: #2c3d58;
  font-size: 28rpx;
  line-height: 1.6;
}

.route-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8c99b2;
}

.route-link {
  margin-top: 8rpx;
  color: #1e86ff;
  font-size: 22rpx;
}

.info-box {
  margin-top: 26rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf2f7;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #7c8aa5;
  font-size: 24rpx;
}

.info-value {
  max-width: 430rpx;
  text-align: right;
  color: #22314b;
  font-size: 26rpx;
}

.remark-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff8f2;
}

.remark-title {
  display: block;
  color: #d77f27;
  font-size: 24rpx;
  font-weight: 700;
}

.remark-text {
  display: block;
  margin-top: 10rpx;
  line-height: 1.7;
  color: #77522d;
  font-size: 24rpx;
}

.user-card {
  padding: 24rpx;
}

.user-row {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.taker-row {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf2f7;
}

.user-main {
  flex: 1;
}

.user-name,
.user-desc,
.user-meta {
  display: block;
}

.user-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #22314b;
}

.user-desc {
  margin-top: 10rpx;
  line-height: 1.6;
  font-size: 24rpx;
  color: #7d8ba6;
}

.user-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #97a4bc;
}

.proof-card,
.rate-card {
  padding: 24rpx;
}

.proof-title,
.rate-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #22314b;
}

.proof-image {
  width: 100%;
  height: 360rpx;
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #eef4fb;
}

.proof-desc {
  display: block;
  margin-top: 12rpx;
  color: #7d8ba6;
  font-size: 24rpx;
  line-height: 1.7;
}

.attachment-list {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.attachment-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  background: #eef4fb;
}

.rate-options {
  display: flex;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-top: 18rpx;
  margin-bottom: 18rpx;
}

.rate-chip {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #f5f8fc;
  color: #5f708d;
  font-size: 24rpx;
}

.rate-chip.active {
  background: #eef6ff;
  color: #1e86ff;
  font-weight: 700;
}
